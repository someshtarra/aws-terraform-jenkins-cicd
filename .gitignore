# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used only locally
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include override files for terraform plugins
.terraformrc
terraform.rc

# SSH Keys and Credentials
*.pem
*.key
*.id_rsa
*.id_rsa.pub
ansible.pem

# Environment files
.env
.env.*

# OS specific files
.DS_Store
Thumbs.db
*.swp
*.swo

# IDE settings
.idea/
.vscode/
